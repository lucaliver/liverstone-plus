{
  "name": "liverstone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run tests/balance.sim.test.ts",
    "e2e": "playwright test",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "tsc --noEmit && biome check && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}
